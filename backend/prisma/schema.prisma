// prisma/schema.prisma
// Job Assigning Timeline Management Platform — v1
// Zero Cost, Zero Card: runs on local PostgreSQL 16 via Docker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  WORKFLOW_ADMIN
  DESIGNER
  CLIENT
}

enum JobStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DELEGATED
  ASSIGNED
  IN_PROGRESS
  PAUSED
  AT_RISK
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  JOB_SUBMITTED
  JOB_ACCEPTED
  JOB_REJECTED
  JOB_ASSIGNED
  JOB_STATUS_CHANGED
  JOB_AT_RISK
  JOB_DELEGATED
  JOB_COMPLETED
  JOB_CANCELLED
  AI_ACTION_PROPOSED
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  REASSIGN
  REJECT
  ACCEPT
  DELEGATE
  CANCEL
  COMPLETE
  PAUSE
  RESUME
  HOLD
  RELEASE
  AI_PROPOSE
  AI_EXECUTE
  AI_REJECT
  UPLOAD
  DOWNLOAD
  EXPORT
}

enum AttachmentType {
  JOB_ATTACHMENT
  DELIVERABLE
  EXPORT_REPORT
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  tenantId       String    @default("default") @map("tenant_id")
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  role           Role
  avatarUrl      String?   @map("avatar_url")
  isActive       Boolean   @default(true) @map("is_active")
  // Designer working hours — configurable per user (Q07)
  workHoursStart String    @default("09:00") @map("work_hours_start")
  workHoursEnd   String    @default("17:00") @map("work_hours_end")
  timezone       String    @default("UTC")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  streamMemberships    StreamMember[]
  submittedJobs        Job[]                  @relation("ClientJobs")
  createdJobs          Job[]                  @relation("CreatedByJobs")
  assignments          JobAssignment[]        @relation("DesignerAssignments")
  assignedByMe         JobAssignment[]        @relation("AssignedByAdmin")
  assignmentHistory    JobAssignmentHistory[] @relation("DesignerHistory")
  assignedByHistory    JobAssignmentHistory[] @relation("AssignedByHistory")
  notifications        Notification[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  aiConversations      AiConversation[]

  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────
// STREAMS
// ─────────────────────────────────────────────

model Stream {
  id          String   @id @default(cuid())
  tenantId    String   @default("default") @map("tenant_id")
  name        String
  description String?
  colorHex    String   @default("#6366f1") @map("color_hex")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members         StreamMember[]
  jobs            Job[]
  delegationsFrom JobDelegation[] @relation("DelegatedFromStream")
  delegationsTo   JobDelegation[] @relation("DelegatedToStream")

  @@index([tenantId, isActive])
  @@map("streams")
}

model StreamMember {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  streamId   String   @map("stream_id")
  isPrimary  Boolean  @default(true) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([userId, streamId])
  @@index([streamId])
  @@map("stream_members")
}

// ─────────────────────────────────────────────
// JOBS
// ─────────────────────────────────────────────

model Job {
  id               String      @id @default(cuid())
  tenantId         String      @default("default") @map("tenant_id")
  jobNumber        String      @unique @map("job_number")
  title            String
  description      String      @db.Text
  status           JobStatus   @default(SUBMITTED)
  priority         JobPriority @default(MEDIUM)
  billingCode      String?     @map("billing_code") @db.VarChar(20)
  deadline         DateTime?
  streamId         String?     @map("stream_id")
  clientId         String      @map("client_id")
  createdById      String      @map("created_by_id")
  notes            String?     @db.Text
  rejectionReason  String?     @db.Text @map("rejection_reason")
  // If resubmitted after rejection — original stays REJECTED (Q01)
  parentJobId      String?     @map("parent_job_id")
  isAtRisk         Boolean     @default(false) @map("is_at_risk")
  atRiskNotifiedAt DateTime?   @map("at_risk_notified_at")
  // Delegation hop counter — max 3 (Q02)
  delegationCount  Int         @default(0) @map("delegation_count")
  completedAt      DateTime?   @map("completed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  stream        Stream?              @relation(fields: [streamId], references: [id])
  client        User                 @relation("ClientJobs", fields: [clientId], references: [id])
  createdBy     User                 @relation("CreatedByJobs", fields: [createdById], references: [id])
  parentJob     Job?                 @relation("Resubmissions", fields: [parentJobId], references: [id])
  resubmissions Job[]                @relation("Resubmissions")
  assignments   JobAssignment[]
  history       JobAssignmentHistory[]
  statusHistory JobStatusHistory[]
  delegations   JobDelegation[]
  attachments   Attachment[]
  deliverables  Deliverable[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([tenantId, status])
  @@index([clientId])
  @@index([streamId, status])
  @@index([deadline])
  @@index([isAtRisk])
  @@index([jobNumber])
  @@map("jobs")
}

// Immutable log of every status change (append-only)
model JobStatusHistory {
  id          String     @id @default(cuid())
  jobId       String     @map("job_id")
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  changedById String     @map("changed_by_id")
  isSystem    Boolean    @default(false) @map("is_system")
  reason      String?    @db.Text
  changedAt   DateTime   @default(now()) @map("changed_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, changedAt])
  @@map("job_status_history")
}

// Active assignments — up to 3 designers per job, one primary (Q14)
model JobAssignment {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  designerId   String   @map("designer_id")
  assignedById String   @map("assigned_by_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  designer   User @relation("DesignerAssignments", fields: [designerId], references: [id])
  assignedBy User @relation("AssignedByAdmin", fields: [assignedById], references: [id])

  @@index([jobId, isActive])
  @@index([designerId, startTime, endTime])
  @@map("job_assignments")
}

// Full reassignment history — visible to Workflow Admin + Admin (Q23)
model JobAssignmentHistory {
  id             String   @id @default(cuid())
  jobId          String   @map("job_id")
  designerId     String   @map("designer_id")
  assignedById   String   @map("assigned_by_id")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  isPrimary      Boolean  @default(false) @map("is_primary")
  unassignedAt   DateTime @default(now()) @map("unassigned_at")
  unassignReason String?  @db.Text @map("unassign_reason")

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  designer   User @relation("DesignerHistory", fields: [designerId], references: [id])
  assignedBy User @relation("AssignedByHistory", fields: [assignedById], references: [id])

  @@index([jobId])
  @@index([designerId])
  @@map("job_assignment_history")
}

// Delegation trail — max 3 hops (Q02)
model JobDelegation {
  id            String   @id @default(cuid())
  jobId         String   @map("job_id")
  fromStreamId  String   @map("from_stream_id")
  toStreamId    String   @map("to_stream_id")
  delegatedById String   @map("delegated_by_id")
  hopNumber     Int      @map("hop_number")
  reason        String?  @db.Text
  delegatedAt   DateTime @default(now()) @map("delegated_at")

  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStream Stream @relation("DelegatedFromStream", fields: [fromStreamId], references: [id])
  toStream   Stream @relation("DelegatedToStream", fields: [toStreamId], references: [id])

  @@index([jobId])
  @@map("job_delegations")
}

// ─────────────────────────────────────────────
// FILE STORAGE
// ─────────────────────────────────────────────

// Max 5 files per job, 50MB each. Allowed: PDF, DOCX, XLSX, PNG, JPG, ZIP, AI, PSD (Q10)
model Attachment {
  id           String         @id @default(cuid())
  jobId        String         @map("job_id")
  uploadedById String         @map("uploaded_by_id")
  type         AttachmentType @default(JOB_ATTACHMENT)
  fileName     String         @map("file_name")
  fileKey      String         @unique @map("file_key")
  mimeType     String         @map("mime_type")
  sizeBytes    BigInt         @map("size_bytes")
  isDeleted    Boolean        @default(false) @map("is_deleted")
  createdAt    DateTime       @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, isDeleted])
  @@map("attachments")
}

// Designer deliverables (Q11) — data model ready, client download UI in v2
model Deliverable {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  fileKey      String   @unique @map("file_key")
  mimeType     String   @map("mime_type")
  sizeBytes    BigInt   @map("size_bytes")
  version      Int      @default(1)
  notes        String?  @db.Text
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("deliverables")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  jobId     String?          @map("job_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

// Append-only audit log — all user + AI actions (Q16), retained 12 months
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String      @default("default") @map("tenant_id")
  actorId    String?     @map("actor_id")
  actorRole  Role?       @map("actor_role")
  isAiAction Boolean     @default(false) @map("is_ai_action")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  jobId      String?     @map("job_id")
  before     Json?
  after      Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @db.Text @map("user_agent")
  requestId  String?     @map("request_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  job   Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([jobId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenFamily String    @map("token_family")
  tokenHash   String    @unique @map("token_hash")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// AI AGENT
// ─────────────────────────────────────────────

// Per-session memory (Q18) — stored for audit replay only
model AiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  streamId  String?  @map("stream_id")
  title     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant" | "tool_call" | "tool_result"
  content        String   @db.Text
  toolName       String?  @map("tool_name")
  toolInput      Json?    @map("tool_input")
  toolOutput     Json?    @map("tool_output")
  tokensUsed     Int?     @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────

// Key-value settings store (Q17)
model Setting {
  id          String   @id @default(cuid())
  tenantId    String   @default("default") @map("tenant_id")
  key         String
  value       String   @db.Text
  description String?
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("settings")
}

// Atomic year-scoped job number counter — prevents duplicates under concurrency
model JobSequence {
  id       String @id @default(cuid())
  tenantId String @default("default") @map("tenant_id")
  year     Int
  sequence Int    @default(0)

  @@unique([tenantId, year])
  @@map("job_sequences")
}
