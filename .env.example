# ──────────────────────────────────────────────────────────────
# Job Assigning Timeline Management Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL via Docker) ──────────────────────────
DATABASE_URL="postgresql://admin:localdev123@localhost:5432/job_timeline_db"

# ── Redis (via Docker) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-in-production-access-secret
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── File Storage (Local Disk via Multer) ──────────────────────
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=50

# ── Email (MailHog via Docker — view at http://localhost:8025) ─
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Job Timeline <noreply@jobtimeline.local>"

# ── AI Agent (Groq — fast Llama 3 inference) ────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192

# ── AI Rate Limiting ──────────────────────────────────────────
AI_DAILY_LIMIT_PER_USER=100

# ── Job Numbering ─────────────────────────────────────────────
JOB_ID_PREFIX=JB
# Result: JB-2024-0001

# ── SLA / AT_RISK threshold ───────────────────────────────────
AT_RISK_THRESHOLD_HOURS=24

# ── Slack Webhook Integration (optional) ──────────────────────
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack notifications (app runs fine without this).
SLACK_WEBHOOK_URL=
